# ==============================================================================
# AUDIRA NetOps AI - Environment Configuration Template
# Never commit actual credentials or secrets to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
WEB_PORT=5180
CORS_ORIGIN=http://localhost:5180,http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql://audira_user:YOUR_STRONG_POSTGRES_PASSWORD@localhost:5432/audira_netops?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=audira_user
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD
DB_NAME=audira_netops

# Cache & Realtime (Redis)
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD

# JWT Authentication (Replace with cryptographically random secrets)
JWT_SECRET=GENERATE_SECURE_RANDOM_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=GENERATE_SECURE_RANDOM_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# Cryptography & Secret Storage (AES-256-GCM)
# Must be a 32-byte hex-encoded string (64 hexadecimal characters)
ENCRYPTION_KEY=GENERATE_64_CHAR_HEX_ENCRYPTION_KEY_FOR_AES_256_GCM

# Local AI - Ollama
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud AI Providers (Optional - only required if provider is selected)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CUSTOM_AI_ENDPOINT=
CUSTOM_AI_API_KEY=

# Network Monitoring & Telemetry
DEFAULT_POLLING_INTERVAL_SECONDS=15
PING_TIMEOUT_MS=2000
SNMP_COMMUNITY_DEFAULT=public

# Notifications & Alerts
NOTIFICATION_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noc-alerts@audira.local

# Demo Network Mode (true enables simulated telemetry if routers are offline)
ENABLE_DEMO_NETWORK=true
