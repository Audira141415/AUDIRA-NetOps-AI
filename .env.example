# ==============================================================================
# AUDIRA NetOps AI - Environment Configuration Template
# Never commit actual credentials or secrets to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://audira_user:audira_secure_password@localhost:5432/audira_netops?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=audira_user
DB_PASSWORD=audira_secure_password
DB_NAME=audira_netops

# Cache & Realtime (Redis)
REDIS_URL=redis://:audira_redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=audira_redis_password

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_audira
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_audira_netops_secure
JWT_REFRESH_EXPIRES_IN=7d

# Cryptography & Secret Storage (AES-256-GCM)
# Must be 32 bytes hex encoded (64 characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local AI - Ollama
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud AI Providers (Optional - only required if provider is selected)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CUSTOM_AI_ENDPOINT=
CUSTOM_AI_API_KEY=

# Network Monitoring & Telemetry
DEFAULT_POLLING_INTERVAL_SECONDS=15
PING_TIMEOUT_MS=2000
SNMP_COMMUNITY_DEFAULT=public

# Notifications & Alerts
NOTIFICATION_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noc-alerts@audira.local

# Demo Network Mode (true enables simulated telemetry if routers are offline)
ENABLE_DEMO_NETWORK=true
