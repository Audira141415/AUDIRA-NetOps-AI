{
  "name": "audira-netops-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AUDIRA NetOps AI - Network Management. Terminal. Automation. AI.",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@audira/web",
    "dev:api": "turbo run dev --filter=@audira/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "pnpm --filter @audira/api run db:migrate",
    "db:seed": "pnpm --filter @audira/api run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
