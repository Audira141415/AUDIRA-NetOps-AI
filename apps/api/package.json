{
  "name": "@audira/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node -e \"console.log('Database schema applied from database/schema/init.sql')\"",
    "db:seed": "node -e \"console.log('Database seeded from database/seeds/seed.sql')\""
  },
  "dependencies": {
    "@audira/ai-agent": "workspace:*",
    "@audira/config": "workspace:*",
    "@audira/logger": "workspace:*",
    "@audira/monitoring": "workspace:*",
    "@audira/routeros": "workspace:*",
    "@audira/security": "workspace:*",
    "@audira/ssh": "workspace:*",
    "@audira/terminal": "workspace:*",
    "@audira/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
